# Virtual 7.1 Surround Sound using HeSuVi 14-channel HRTF
# Place in ~/.config/pipewire/pipewire.conf.d/
#
# HeSuVi 14-channel order:
#  0: FL-L   1: FL-R
#  2: SL-L   3: SL-R
#  4: BL-L   5: BL-R
#  6: FC-L  13: FC-R
#  8: FR-L   7: FR-R
# 10: SR-L   9: SR-R
# 12: BR-L  11: BR-R

context.modules = [
    { name = libpipewire-module-filter-chain
        args = {
            node.description = "Virtual Surround 7.1"
            media.name       = "Virtual Surround 7.1"
            filter.graph = {
                nodes = [
                    # duplicate inputs
                    { type = builtin label = copy name = copyFL }
                    { type = builtin label = copy name = copyFR }
                    { type = builtin label = copy name = copyFC }
                    { type = builtin label = copy name = copyLFE }
                    { type = builtin label = copy name = copyRL }
                    { type = builtin label = copy name = copyRR }
                    { type = builtin label = copy name = copySL }
                    { type = builtin label = copy name = copySR }

                    # convolver per speaker per ear
                    # FL
                    { type = builtin label = convolver name = convFL_L  config = { filename = "/home/tornado300/.config/pipewire/hrtf/cmss_rx+.wav" channel =  0 } }
                    { type = builtin label = convolver name = convFL_R  config = { filename = "/home/tornado300/.config/pipewire/hrtf/cmss_rx+.wav" channel =  1 } }
                    # FR
                    { type = builtin label = convolver name = convFR_L  config = { filename = "/home/tornado300/.config/pipewire/hrtf/cmss_rx+.wav" channel =  8 } }
                    { type = builtin label = convolver name = convFR_R  config = { filename = "/home/tornado300/.config/pipewire/hrtf/cmss_rx+.wav" channel =  7 } }
                    # FC
                    { type = builtin label = convolver name = convFC_L  config = { filename = "/home/tornado300/.config/pipewire/hrtf/cmss_rx+.wav" channel =  6 } }
                    { type = builtin label = convolver name = convFC_R  config = { filename = "/home/tornado300/.config/pipewire/hrtf/cmss_rx+.wav" channel = 13 } }
                    # SL
                    { type = builtin label = convolver name = convSL_L  config = { filename = "/home/tornado300/.config/pipewire/hrtf/cmss_rx+.wav" channel =  2 } }
                    { type = builtin label = convolver name = convSL_R  config = { filename = "/home/tornado300/.config/pipewire/hrtf/cmss_rx+.wav" channel =  3 } }
                    # SR
                    { type = builtin label = convolver name = convSR_L  config = { filename = "/home/tornado300/.config/pipewire/hrtf/cmss_rx+.wav" channel = 10 } }
                    { type = builtin label = convolver name = convSR_R  config = { filename = "/home/tornado300/.config/pipewire/hrtf/cmss_rx+.wav" channel =  9 } }
                    # RL (back left)
                    { type = builtin label = convolver name = convRL_L  config = { filename = "/home/tornado300/.config/pipewire/hrtf/cmss_rx+.wav" channel =  4 } }
                    { type = builtin label = convolver name = convRL_R  config = { filename = "/home/tornado300/.config/pipewire/hrtf/cmss_rx+.wav" channel =  5 } }
                    # RR (back right)
                    { type = builtin label = convolver name = convRR_L  config = { filename = "/home/tornado300/.config/pipewire/hrtf/cmss_rx+.wav" channel = 12 } }
                    { type = builtin label = convolver name = convRR_R  config = { filename = "/home/tornado300/.config/pipewire/hrtf/cmss_rx+.wav" channel = 11 } }

                    # LFE: route through FL convolver (no dedicated LFE HRTF in HeSuVi)
                    { type = builtin label = convolver name = convLFE_L config = { filename = "/home/tornado300/.config/pipewire/hrtf/cmss_rx+.wav" channel =  6 } }
                    { type = builtin label = convolver name = convLFE_R config = { filename = "/home/tornado300/.config/pipewire/hrtf/cmss_rx+.wav" channel =  13 } }

                    # mixers for left and right ear
                    { type = builtin label = mixer name = mixL }
                    { type = builtin label = mixer name = mixR }
                ]
                links = [
                    # split inputs to convolvers
                    { output = "copyFL:Out"   input = "convFL_L:In" }
                    { output = "copyFL:Out"   input = "convFL_R:In" }
                    { output = "copyFR:Out"   input = "convFR_L:In" }
                    { output = "copyFR:Out"   input = "convFR_R:In" }
                    { output = "copyFC:Out"   input = "convFC_L:In" }
                    { output = "copyFC:Out"   input = "convFC_R:In" }
                    { output = "copySL:Out"   input = "convSL_L:In" }
                    { output = "copySL:Out"   input = "convSL_R:In" }
                    { output = "copySR:Out"   input = "convSR_L:In" }
                    { output = "copySR:Out"   input = "convSR_R:In" }
                    { output = "copyRL:Out"   input = "convRL_L:In" }
                    { output = "copyRL:Out"   input = "convRL_R:In" }
                    { output = "copyRR:Out"   input = "convRR_L:In" }
                    { output = "copyRR:Out"   input = "convRR_R:In" }
                    { output = "copyLFE:Out"  input = "convLFE_L:In" }
                    { output = "copyLFE:Out"  input = "convLFE_R:In" }

                    # mix all left-ear outputs
                    { output = "convFL_L:Out"  input = "mixL:In 1" }
                    { output = "convFR_L:Out"  input = "mixL:In 2" }
                    { output = "convFC_L:Out"  input = "mixL:In 3" }
                    { output = "convSL_L:Out"  input = "mixL:In 4" }
                    { output = "convSR_L:Out"  input = "mixL:In 5" }
                    { output = "convRL_L:Out"  input = "mixL:In 6" }
                    { output = "convRR_L:Out"  input = "mixL:In 7" }
                    { output = "convLFE_L:Out" input = "mixL:In 8" }

                    # mix all right-ear outputs
                    { output = "convFL_R:Out"  input = "mixR:In 1" }
                    { output = "convFR_R:Out"  input = "mixR:In 2" }
                    { output = "convFC_R:Out"  input = "mixR:In 3" }
                    { output = "convSL_R:Out"  input = "mixR:In 4" }
                    { output = "convSR_R:Out"  input = "mixR:In 5" }
                    { output = "convRL_R:Out"  input = "mixR:In 6" }
                    { output = "convRR_R:Out"  input = "mixR:In 7" }
                    { output = "convLFE_R:Out" input = "mixR:In 8" }
                ]
                inputs  = [ "copyFL:In" "copyFR:In" "copyFC:In" "copyLFE:In" "copyRL:In" "copyRR:In" "copySL:In" "copySR:In" ]
                outputs = [ "mixL:Out" "mixR:Out" ]
            }
            capture.props = {
                node.name      = "virtual-surround-7.1-sink"
                media.class    = Audio/Sink
                audio.channels = 8
                audio.position = [ FL FR FC LFE RL RR SL SR ]
            }
            playback.props = {
                node.name      = "virtual-surround-7.1-output"
                node.passive   = true
                audio.channels = 2
                audio.position = [ FL FR ]
            }
        }
    }
]
