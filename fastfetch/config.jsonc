{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": ": "
  },
  "logo": {
    "type": "builtin",
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌────────────────────────────────────────────┐"
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "format": "{release>17}",
      "keyColor": "#C792EA"
    },
    {
      "type": "packages",
      "format": "{pacman>6} Pacman",
      "key": "  󰏗 Packages",
      "keyColor": "#D4C088"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "┌────────────────────────────────────────────┐"
    },
    {
      "type": "cpu",
      "format": "       {name~27,37} @ {freq-max}",
      "key": "   CPU",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "format": "    {used} / {total}",
      "key": "  \uefc5 Memory",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "format": "       {1} {2}",
      "key": "  󰊴 GPU",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "format": "{3~0,6}{3~7,13}{3~13,31}",
      "key": "   GPU Driver",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "┌────────────────────────────────────────────┐"
    },
    {
      "type": "wifi",
      "format": "      {ssid}({status}) {signal-quality}",
      "key": "  󰖩 Wifi",
      "keyColor": "#88C0D0"
    },
    {
      "type": "publicip",
      "format": " {ip}({location})",
      "key": "  󰇧 Public IP",
      "keyColor": "#94E2D5"
    },
    {
      "type": "localip",
      "format": " {ipv4}",
      "key": "  󰲝 Local  IP",
      "keyColor": "#94E2D5"
    },
    {
      "type": "localip",
      "format": "       {mac}",
      "showMac": true,
      "key": "  󰆧 Mac",
      "keyColor": "#8FBCBB"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "┌────────────────────────────────────────────┐"
    },
    {
      "type": "command",
      "format": "    {}",
      "key": "  󱦟 OS Age",
      "keyColor": "#FFB86C",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "format": "    {formatted}",
      "key": "  󱫐 Uptime",
      "keyColor": "#FFB86C"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────┘"
    }
  ]
}
